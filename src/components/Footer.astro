---
import { footer } from '../data/site';
---

<footer class="w-full bg-surface-pure border-t border-border-hairline py-12 px-6 sm:px-10">
	<div
		class="max-w-3xl mx-auto flex flex-col sm:flex-row items-baseline justify-between gap-6 text-[10px] font-sans tracking-[0.2em] uppercase text-ink-subtle"
	>
		<div class="space-y-1">
			<div>{footer.copyright}</div>
			<div class="font-light text-stone-400">{footer.colophon}</div>
		</div>
		<div class="flex items-center gap-6">
			{
				footer.links.map((link) => (
					<a href={link.href} class="hover:text-ink-black transition-colors">
						{link.label}
					</a>
				))
			}
		</div>
	</div>
</footer>
