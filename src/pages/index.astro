---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Frontispiece from '../components/Frontispiece.astro';
import About from '../components/About.astro';
import WorksCatalog from '../components/WorksCatalog.astro';
import Poetics from '../components/Poetics.astro';
import Curriculum from '../components/Curriculum.astro';
import Footer from '../components/Footer.astro';
---

<Layout>
	<Header />
	<main class="w-full flex-1">
		<article class="max-w-3xl mx-auto px-6 sm:px-10 py-20 sm:py-28 space-y-28 sm:space-y-36">
			<Frontispiece />
			<About />
			<WorksCatalog />
			<Poetics />
			<Curriculum />
		</article>
	</main>
	<Footer />
</Layout>
